# Copy this file to .env.local for local development.
# NEVER commit the real .env / .env.local file — see .gitignore.
# Values below are variable NAMES ONLY. No real secrets belong in source control.

NODE_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:3000
DATABASE_URL=postgresql://intellihire:intellihire@localhost:5432/intellihire
REDIS_URL=redis://localhost:6379
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
ADMIN_EMAIL=
SESSION_SECRET=

# AI — server-side only. NVIDIA is preferred, OpenRouter is the fallback AI provider.
NVIDIA_API_KEY=
NVIDIA_API_BASE_URL=https://integrate.api.nvidia.com/v1/chat/completions
NVIDIA_MODEL=nvidia/nemotron-3.5-nano-30b-a3b
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

# Personal AI Research Intern retrieval. Without this key, the app returns an explicit
# insufficient-external-evidence state instead of fabricating research sources.
TAVILY_API_KEY=

LOG_LEVEL=debug
