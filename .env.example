# Copy this file to .env.local for local development.
# NEVER commit the real .env / .env.local file.

NODE_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:3000
DATABASE_URL=postgresql://intellihire:intellihire@localhost:5432/intellihire
REDIS_URL=redis://localhost:6379
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
ADMIN_EMAIL=
SESSION_SECRET=

# AI — server-side only. NVIDIA NIM is primary; OpenAI is the fallback.
NVIDIA_API_KEY=
NVIDIA_API_BASE_URL=https://integrate.api.nvidia.com/v1/chat/completions
NVIDIA_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning
OPENAI_API_KEY=
OPENAI_API_BASE_URL=https://api.openai.com/v1/chat/completions
OPENAI_MODEL=gpt-4o-mini
LOG_LEVEL=debug
