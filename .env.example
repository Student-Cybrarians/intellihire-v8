# Copy this file to .env.local for local development.
# NEVER commit the real .env / .env.local file — see .gitignore.
# Values below are variable NAMES ONLY. No real secrets belong in this file
# or anywhere in source control.

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
NODE_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Database (PostgreSQL) — see docker-compose.yml for a local instance
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://intellihire:intellihire@localhost:5432/intellihire

# ---------------------------------------------------------------------------
# Redis — optional. OAuth/session flows work without it; rate limiting falls
# back to an in-process limiter when Redis is unavailable.
# ---------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# ---------------------------------------------------------------------------
# Google OAuth 2.0 / OpenID Connect
# See docs/GOOGLE_OAUTH_SETUP.md for how to obtain these from Google Cloud Console.
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# ---------------------------------------------------------------------------
# Administrator identity
# Exactly this verified Google email receives ADMIN privileges.
# Keep this server-side; do not use NEXT_PUBLIC_ADMIN_EMAIL.
# ---------------------------------------------------------------------------
ADMIN_EMAIL=

# ---------------------------------------------------------------------------
# Session
# High-entropy random string, 32+ characters.
# ---------------------------------------------------------------------------
SESSION_SECRET=

# ---------------------------------------------------------------------------
# AI — server-side only.
# Module 1 uses a real hosted AI provider when one of these keys is present.
# NVIDIA is preferred when NVIDIA_API_KEY is configured; otherwise OpenRouter
# is used. Never expose either key through NEXT_PUBLIC_*.
# ---------------------------------------------------------------------------
NVIDIA_API_KEY=
NVIDIA_API_BASE_URL=https://integrate.api.nvidia.com/v1/chat/completions
# Current NVIDIA default used when NVIDIA_MODEL is omitted.
NVIDIA_MODEL=nvidia/nemotron-3.5-nano-30b-a3b

OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
LOG_LEVEL=debug
