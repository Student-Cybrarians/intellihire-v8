# Copy this file to .env.local for local development.
# NEVER commit the real .env / .env.local file — see .gitignore.
# Values below are variable NAMES ONLY. No real secrets belong in this file
# or anywhere in source control.

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
NODE_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Database (PostgreSQL) — see docker-compose.yml for a local instance
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://intellihire:intellihire@localhost:5432/intellihire

# ---------------------------------------------------------------------------
# Redis — optional. OAuth/session flows work without it (see docs/ARCHITECTURE.md);
# rate limiting and future permission caching use it when present.
# ---------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# ---------------------------------------------------------------------------
# Google OAuth 2.0 / OpenID Connect
# See docs/GOOGLE_OAUTH_SETUP.md for how to obtain these from Google Cloud Console.
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# ---------------------------------------------------------------------------
# Session
# High-entropy random string, 32+ characters. Generate with:
#   openssl rand -base64 48
# ---------------------------------------------------------------------------
SESSION_SECRET=

# ---------------------------------------------------------------------------
# NVIDIA AI provider — server-side only. Never referenced from the client
# bundle, never prefixed NEXT_PUBLIC_. See docs/AI_PROVIDER.md.
# ---------------------------------------------------------------------------
NVIDIA_API_KEY_NEMOTRON_VL_12B=
NVIDIA_API_KEY_LLAMA_NEMOTRON_VL_8B=
NVIDIA_API_KEY_NEMOTRON_9B=

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
LOG_LEVEL=debug
